# ==========================================
# GeoGen AI — Environment Configuration Example
# ==========================================

# Backend Settings
APP_ENV=production
DATA_MODE=live

# AI & Language Services (Google Gemini)
# Get your Gemini key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Mapbox Access Token (Live Street Geometry & Directions)
# Get your token from: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# Optional: Google Maps Platform Key (if using Google Maps Services)
GOOGLE_MAPS_SERVER_API_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Optional NLP Model Override (default: lexicon_fallback)
SENTIMENT_MODEL=lexicon_fallback
